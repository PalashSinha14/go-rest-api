# Copy to .env and adjust. Every value below is the built-in default, so the
# service runs with none of them set — except JWT_SECRET in production.

APP_ENV=development          # "production" switches logs to JSON and Gin to release mode
PORT=8080
LOG_LEVEL=info               # debug | info | warn | error

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=library

# Startup fails if this is left at the default while APP_ENV=production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL=24h

LOAN_PERIOD=336h             # 14 days
MAX_ACTIVE_LOANS=5
SHUTDOWN_TIMEOUT=10s
